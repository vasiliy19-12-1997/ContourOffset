<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Области из DWG" Width="500" SizeToContent="Height" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
  <StackPanel Margin="20">
    <TextBlock Text="Слой DWG"/>
    <ComboBox x:Name="Layer" Margin="0,4,0,12" IsEditable="True"
              IsTextSearchEnabled="True" SelectionChanged="layer_changed"/>
    <TextBlock Text="Источник границ"/>
    <ComboBox x:Name="Source" Margin="0,4,0,12" SelectedIndex="0">
      <ComboBoxItem Content="Заливки, доступные как грани или сетки"/>
      <ComboBoxItem Content="Замкнутые полилинии и цепочки линий"/>
    </ComboBox>
    <TextBlock Text="Имя"/>
    <TextBox x:Name="RegionName" Text="Газон" Padding="4" Margin="0,4,0,12"/>
    <TextBlock Text="IFC-класс"/>
    <TextBox x:Name="IfcClass" Text="IfcCivilElement" Padding="4" Margin="0,4,0,12"/>
    <TextBlock Text="Материал"/>
    <TextBox x:Name="MaterialName" Text="Озеленение" Padding="4" Margin="0,4,0,12"/>
    <CheckBox x:Name="WriteArea" IsChecked="True"
              Content="Записать спроецированную площадь в «Площадь озеленения»"/>
    <TextBlock x:Name="InputError" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,8,0,0"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="Далее" Click="accept" IsDefault="True"
              MinWidth="92" Padding="8,4" Margin="0,0,8,0"/>
      <Button Content="Отмена" IsCancel="True" MinWidth="80" Padding="8,4"/>
    </StackPanel>
  </StackPanel>
</Window>
